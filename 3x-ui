申请证书

acme.sh --issue -d la.yourdomain.top --nginx

安装证书

acme.sh --install-cert -d la.yourdomain.top \
--key-file /etc/nginx/ssl/la.yourdomain.top.key \
--fullchain-file /etc/nginx/ssl/la.yourdomain.top.crt \
--reloadcmd "systemctl reload nginx"

允许面板端口
ufw allow 43495

允许入站端口
ufw allow 54195


```ini /etc/nginx/sites-available/la
# HTTP 配置 (80 端口) - 用于 acme.sh 验证
server {
    listen 80;
    server_name la.yourdomain.top;

    # 网站根目录
    root /var/www/html;
    index index.html index.htm;

    # acme.sh 验证路径
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # 反向代理配置
    location / {
        proxy_pass https://127.0.0.1:43495/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;

        gzip on;
        gzip_http_version 1.1;
        gzip_comp_level 3;
        gzip_types text/plain application/json application/javascript text/css;
    }
}
```

```ini /etc/nginx/sites-available/la.ssl
# HTTPS 配置 (443 端口)
server {
    listen 443 ssl http2;
    server_name la.yourdomain.top;

    # SSL 证书配置
    ssl_certificate /etc/nginx/ssl/la.yourdomain.top.crt;
    ssl_certificate_key /etc/nginx/ssl/la.yourdomain.top.key;

    # SSL 优化配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 反向代理配置
    location / {
        proxy_pass https://127.0.0.1:43495/;
        index index.html index.htm;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;

        gzip on;
        gzip_http_version 1.1;
        gzip_comp_level 3;
        gzip_types text/plain application/json application/javascript text/css;
    }
}

# HTTP 重定向到 HTTPS (80 端口)
server {
    listen 80;
    server_name la.yourdomain.top;
    return 301 https://$server_name$request_uri;
}
```